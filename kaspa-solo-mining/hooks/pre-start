#!/usr/bin/env bash
set -euo pipefail

APP_SRC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

install -d -m 0750 -o 1000 -g 1000 "${APP_DATA_DIR}/data"
install -d -m 0750 -o 1000 -g 1000 "${APP_DATA_DIR}/kaspad_data"

# Ensure runtime config.yaml exists for Stratum Bridge
if [ ! -f "${APP_DATA_DIR}/data/config.yaml" ]; then
  install -m 0644 -o 1000 -g 1000 "${APP_SRC_DIR}/config/bridge.yaml" "${APP_DATA_DIR}/data/config.yaml"
fi

chown -R 1000:1000 "${APP_DATA_DIR}/data"
chown -R 1000:1000 "${APP_DATA_DIR}/kaspad_data"

